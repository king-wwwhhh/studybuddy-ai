# ============================================================
# 期末速成助手 (StudyBuddy AI) 环境变量示例
# 复制为 .env 并按需填写（.env 已被 .gitignore 忽略，不会提交）。
# 所有变量也可直接通过系统/容器环境变量注入。
# ============================================================

# ---- 必填：DashScope 百炼 API Key（https://bailian.console.aliyun.com/）----
# 缺省时应用自动降级启动（AI 功能不可用，计划/打卡等其余功能正常）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 可选：自定义 DashScope 兼容网关地址（默认 https://dashscope.aliyuncs.com）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- Milvus 向量库（二选一）----
# 方式 A：本地 Milvus（docker compose -f vector-database.yml up -d）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 方式 B：Zilliz Cloud Serverless（设置后优先于 host/port）
MILVUS_URI=
MILVUS_TOKEN=

# ---- 可选：知识库 GitHub 真源（需本机 SSH 可访问该仓库）----
# 不设置则上传仅落本地向量库，GitHub 真源自动降级
GITHUB_REPO_URL=
GITHUB_PUSH_ENABLED=false

# ---- 可选：覆盖默认存储路径 / 端口 / 主密钥 ----
# SPRING_DATASOURCE_URL=jdbc:sqlite:./study_agent_data/study.db
# FILE_UPLOAD_PATH=./study_agent_data/uploads
# APP_DATA_DIR=./study_agent_data
# SERVER_PORT=9900
# APP_MASTER_KEY=your-master-key
